{
  "name": "autoclicker-rpa",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "gen": "node scripts/build-templates.mjs",
    "predev": "npm run gen",
    "dev": "tsx server.ts",
    "prestart": "npm run gen",
    "start": "tsx server.ts",
    "prebuild": "npm run gen",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true})\"",
    "prelint": "npm run gen",
    "lint": "tsc --noEmit",
    "pretest": "npm run gen",
    "test": "tsx --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright-core": "^1.64.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
